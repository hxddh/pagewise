{
  "name": "pagewise",
  "private": true,
  "version": "16.0.0",
  "description": "Local desktop PDF agent — page-wise AI analysis",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare:pdfjs": "node scripts/copy-pdfjs-assets.mjs",
    "prepare:ocr": "node scripts/copy-ocr-assets.mjs",
    "dev": "npm run prepare:pdfjs && npm run prepare:ocr && vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:css": "node scripts/check-css-tokens.mjs",
    "check:css-order": "node scripts/check-css-order.mjs",
    "check:buttons": "node scripts/check-raw-buttons.mjs",
    "check:i18n": "node scripts/check-i18n-keys.mjs",
    "version:sync": "node scripts/sync-version.mjs",
    "icons:sync-svg": "node scripts/generate-app-icon.mjs",
    "icons:generate": "npm run icons:sync-svg && tauri icon app-icon.svg -o src-tauri/icons",
    "verify:bundle-version": "node scripts/verify-bundle-version.mjs",
    "prebuild": "npm run prepare:pdfjs && npm run prepare:ocr && npm run check:secrets && npm run check:css && npm run check:css-order && npm run check:buttons && npm run check:i18n",
    "tauri": "tauri",
    "ui:shots": "node scripts/ui-shots.mjs",
    "postbuild": "node scripts/check-bundle.mjs",
    "audit:request": "node scripts/request-audit.mjs",
    "audit:citations": "node scripts/citation-audit.mjs",
    "audit:ocr": "node scripts/ocr-audit.mjs",
    "audit:tables": "node scripts/table-audit.mjs",
    "audit:claims": "node scripts/claims-audit.mjs",
    "ui:inventory": "node scripts/ui-inventory.mjs",
    "eval": "vitest run --config eval/vitest.config.ts",
    "eval:fetch": "node eval/corpus/fetch.mjs",
    "eval:corpus": "node eval/corpus/build.mjs && python3 eval/corpus/build_reportlab.py",
    "eval:live": "node eval/live/run.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.80",
    "@ai-sdk/react": "^4.0.125",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.6.0",
    "@tauri-apps/plugin-store": "^2.5.0",
    "ai": "^7.0.122",
    "lucide-react": "^1.48.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tesseract.js": "^7.0.0",
    "wasm-feature-detect": "^1.9.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "hyphen": "^1.14.1",
    "jsdom": "^30.1.1",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
